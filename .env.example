# Copy this file to .env and fill in the Hive dev test accounts (ask a teammate for them).
# .env is git-ignored; this example file is the only one that gets committed.
#
#   cp .env.example .env

# Main Professor (Faculty) account
HIVE_VALID_EMAIL=
HIVE_VALID_PASSWORD=

# Student account, for role/permission tests
HIVE_STUDENT_EMAIL=
HIVE_STUDENT_PASSWORD=

# Second Professor, for "another professor" tests
HIVE_PROFESSOR2_EMAIL=
HIVE_PROFESSOR2_PASSWORD=

# Deactivated account, for Login TC008
HIVE_DEACTIVATED_EMAIL=
HIVE_DEACTIVATED_PASSWORD=

# Optional: point the suites at another environment
# BASE_URL=https://hive-dev.thegritcity.com
